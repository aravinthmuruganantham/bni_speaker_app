# Copy to .env for local use (make dev loads it). Never commit the real .env.

# Local dev server port (make dev defaults to 4817 if unset)
PORT=4817

# PIN that protects the remote and lineup controls (leave empty locally for no PIN)
ADMIN_PIN=

# Upstash Redis REST credentials (leave empty locally to use in-memory storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
